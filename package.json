{
  "name": "mykeep",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @mykeep/web",
    "dev": "npm run dev --workspace @mykeep/web",
    "lint": "npm run lint --workspace @mykeep/web",
    "test": "npm run test --workspace @mykeep/web",
    "test:run": "npm run test:run --workspace @mykeep/web",
    "typecheck": "npm run typecheck --workspace @mykeep/web"
  }
}
